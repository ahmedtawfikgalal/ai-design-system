{
  "name": "@ahmed.tawfik.galal/ai-design-system",
  "version": "0.1.0",
  "description": "An AI-ready design system specification: 223 design tokens, 34 component specs and 8 UX patterns in machine-readable JSON, with source attribution, WCAG 2.2 AA accessibility and Arabic/RTL rules. Built on an unofficial Fly Emirates concept.",
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "ai",
    "llm",
    "mcp",
    "ai-agents",
    "json-schema",
    "specification",
    "accessibility",
    "wcag",
    "rtl",
    "arabic",
    "ux",
    "airline",
    "figma-tokens"
  ],
  "author": {
    "name": "Ahmed Tawfik Galal",
    "url": "https://github.com/ahmedtawfikgalal"
  },
  "license": "MIT",
  "homepage": "https://github.com/ahmedtawfikgalal/ai-design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedtawfikgalal/ai-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/ahmedtawfikgalal/ai-design-system/issues"
  },
  "type": "module",
  "files": [
    "manifest.json",
    "schemas/",
    "tokens/",
    "foundations/",
    "components/",
    "patterns/",
    "layouts/",
    "accessibility/",
    "rtl/",
    "references/",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./tokens.json": "./tokens/tokens.json",
    "./components": "./components/index.json",
    "./components/*": "./components/*/spec.json",
    "./patterns": "./patterns/index.json",
    "./patterns/*": "./patterns/*.json",
    "./layouts": "./layouts/layouts.json",
    "./references": "./references/sources.json",
    "./schemas/*": "./schemas/*",
    "./foundations/*": "./foundations/*",
    "./accessibility/*": "./accessibility/*",
    "./rtl/*": "./rtl/*",
    "./package.json": "./package.json",
    "./tokens/values.json": "./tokens/values.json",
    "./tokens.css": "./tokens/tokens.css",
    "./fonts.css": "./tokens/fonts.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/build.mjs --check && node scripts/validate.mjs",
    "prepublishOnly": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}
