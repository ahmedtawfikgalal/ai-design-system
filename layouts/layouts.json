{
  "$schema": "../schemas/manifest.schema.json#/$defs/layouts",
  "schemaVersion": "1.0.0",
  "description": "Breakpoints, grid, containers and per-breakpoint adaptations. Mobile-first; media queries use em so layouts follow the user's default font size. Pixel values assume the 16px default.",
