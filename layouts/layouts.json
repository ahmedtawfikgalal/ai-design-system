        "tag": "Rec",
        "confidence": "proposed"
      }
    }
  ],
  "grid": {
    "tokens": {
      "columns": "--grid-columns",
      "gutter": "--grid-gutter",
      "pageMargin": "--page-margin"
    },
    "layoutStrategyCss": "/* Mobile base */\n.container {\n  box-sizing: border-box;\n  padding-inline: var(--page-margin);\n  margin-inline: auto;\n  max-width: calc(var(--container-max) + 2 * var(--page-margin));   /* content never exceeds 1280px */\n}\n.grid      { display: grid; grid-template-columns: repeat(var(--grid-columns), 1fr); column-gap: var(--grid-gutter); }\n.booking   { display: block; }\n\n/* md — tokens.css switches --grid-columns to 8, gutter 24, margin 32 */\n@media (min-width: 48em) { }\n\n/* lg — 12 columns, margin 40, persistent summary sidebar */\n@media (min-width: 64em) {\n  .booking { display: grid; grid-template-columns: 8fr 4fr; column-gap: var(--grid-gutter); }\n  .booking__summary { position: sticky; top: calc(48px + var(--space-6)); align-self: start; }\n}\n\n/* xl — gutter 32, margin 80 (tokens only) */\n@media (min-width: 90em) { }",
    "columnMaths": [
      {
        "breakpoint": "sm",
        "viewport": "375px",
        "content": "343px",
        "column": "(343 − 3×16) / 4 ≈ 73.8px"
      },
      {
        "breakpoint": "md",
        "viewport": "768px",
        "content": "704px",
        "column": "(704 − 7×24) / 8 = 67px"
      },
      {
        "breakpoint": "lg",
        "viewport": "1024px",
        "content": "944px",
        "column": "(944 − 11×24) / 12 ≈ 56.7px. Sidebar (4 cols) ≈ 299px."
      },
      {
        "breakpoint": "lg",
        "viewport": "1360px+",
        "content": "1280px",
        "column": "(1280 − 11×24) / 12 ≈ 84.7px"
      },
      {
        "breakpoint": "xl",
        "viewport": "1440px",
        "content": "1280px",
        "column": "(1280 − 11×32) / 12 ≈ 77.3px"
      }
    ]
  },
