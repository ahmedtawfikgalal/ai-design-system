      "id": "sm",
      "minWidth": "0",
      "range": "0 – 767px (designs start at 320px)",
      "columns": 4,
      "gutter": "16px",
      "pageMargin": "16px",
      "contentWidth": "fluid",
      "source": {
        "tag": "A · unverified (range, columns). Rec (gutter, margin).",
        "confidence": "inferred",
        "mixed": true
      }
    },
    {
      "id": "md",
      "minWidth": "48em",
      "range": "768 – 1023px",
      "columns": 8,
      "gutter": "24px",
      "pageMargin": "32px",
      "contentWidth": "fluid",
      "source": {
        "tag": "A · unverified. Rec.",
        "confidence": "inferred",
        "mixed": true
      }
    },
    {
      "id": "lg",
      "minWidth": "64em",
      "range": "1024 – 1439px",
      "columns": 12,
      "gutter": "24px",
      "pageMargin": "40px",
      "contentWidth": "fluid, up to 1280px",
      "source": {
        "tag": "A · unverified. Rec.",
        "confidence": "inferred",
        "mixed": true
      }
    },
    {
      "id": "xl",
      "minWidth": "90em",
      "range": "1440px+",
      "columns": 12,
      "gutter": "32px",
      "pageMargin": "80px minimum; grows on wider screens",
      "contentWidth": "1280px, centred",
      "source": {
        "tag": "A · unverified. Max width: Rec · approved over Live ~1400px.",
        "confidence": "inferred",
        "mixed": true,
        "approved": true,
        "decisions": [
          "D12",
          "D22"
        ]
      }
    }
  ],
  "containers": [
    {
      "token": "--container-max",
      "value": "1280px (80rem) of content; the container adds --page-margin on each side",
      "source": {
        "tag": "A · unverified, Rec · approved (D12)",
        "confidence": "inferred",
        "mixed": true,
        "approved": true,
        "decisions": [
          "D12"
